#!/bin/sh
# Starts the real claude with the account chosen for this folder (.claude-account).
here=$(cd "$(dirname "$0")" && pwd)
if [ -f .claude-account ]; then
  acct=$(tr -d '\r\n' < .claude-account)
  export CLAUDE_CONFIG_DIR="${USERPROFILE:-$HOME}/.claude-$acct"
  if [ ! -d "$CLAUDE_CONFIG_DIR" ]; then
    echo "claude-code-multi-account: no account '$acct' on this machine. Create it with: claude-use add $acct" >&2
    exit 1
  fi
else
  unset CLAUDE_CONFIG_DIR
fi
IFS=:
for d in $PATH; do
  [ "$d" = "$here" ] && continue
  for f in "$d/claude" "$d/claude.exe"; do
    [ -f "$f" ] && [ -x "$f" ] && exec "$f" "$@"
  done
done
# Old "local" installs live here, behind a shell alias instead of on PATH.
[ -x "$HOME/.claude/local/claude" ] && exec "$HOME/.claude/local/claude" "$@"
echo "claude-code-multi-account: could not find the real claude on PATH." >&2
exit 1
